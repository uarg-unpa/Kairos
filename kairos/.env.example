# ===========================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ===========================================
# Copie este archivo a .env y complete con sus valores reales
# NO COMMITEAR EL ARCHIVO .env AL REPOSITORIO

# ===========================================
# MySQL Database Configuration
# ===========================================
MYSQL_ROOT_PASSWORD=your_secure_mysql_password

# ===========================================
# Backend Configuration
# ===========================================
# JWT Secret (generar una clave segura de al menos 64 caracteres)
JWT_SECRET=8d7f3a9c2b1e4f6g7h8j9k0l1m2n3o4p5q6r7s8t9u0v1w2x3y4z5a6b7c8d9e0f

# Google OAuth2 Credentials (Backend)
# Obtener de: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Admin Emails (separados por coma)
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# ===========================================
# Frontend Configuration
# ===========================================
# Google OAuth2 Client ID (Frontend - puede ser el mismo que el backend)
GOOGLE_CLIENT_ID_FRONTEND=your-google-client-id.apps.googleusercontent.com

# API Base URL (URL del backend desde el navegador del cliente)
# Para desarrollo local: http://localhost:8080
# Para producción: https://your-domain.com/api
API_BASE_URL=http://localhost:8080
