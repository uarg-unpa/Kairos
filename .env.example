# =============================================================================
# KAIROS - Plantilla de Variables de Entorno (.env)
# =============================================================================
# Instrucciones:
# 1. Copia este archivo como '.env' en la raíz del proyecto:
#    cp .env.example .env   (Linux/Mac)
#    Copy-Item .env.example .env (PowerShell)
# 2. Reemplaza los valores de ejemplo con tus credenciales reales antes de levantar Docker.
# =============================================================================

# ─────────────────────────────────────────────────────────────
# 1. Base de Datos MySQL
# ─────────────────────────────────────────────────────────────
# Contraseña para el usuario root de MySQL en la versión limpia (docker-compose.yml)
# Puerto mapeado: 3306
SPRING_DATASOURCE_PASSWORD=tu_contrasenia_root_mysql_aqui

# Contraseña para la base de datos de la versión DEMO con datos (docker-compose.demo.yml)
# Puerto mapeado: 3307
DEMO_DB_PASSWORD=kairos_demo_2026


# ─────────────────────────────────────────────────────────────
# 2. Google OAuth 2.0 (Inicio de Sesión con Google)
# ─────────────────────────────────────────────────────────────
# Se obtienen desde Google Cloud Console (https://console.cloud.google.com):
# APIs y servicios > Credenciales > ID de cliente OAuth 2.0 (Aplicación web)
#
# Configuración requerida en Google Cloud Console:
# - Orígenes autorizados de JavaScript:
#     http://localhost
#     http://localhost:80
#     http://localhost:4200
#     http://localhost:8082   (para la versión demo)
# - URI de redireccionamiento autorizados:
#     http://localhost:8080/login/oauth2/code/google
#     http://localhost:8081/login/oauth2/code/google  (para la versión demo)
GOOGLE_CLIENT_ID=TU_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=TU_GOOGLE_CLIENT_SECRET


# ─────────────────────────────────────────────────────────────
# 3. JWT (JSON Web Tokens)
# ─────────────────────────────────────────────────────────────
# Clave secreta utilizada para firmar los tokens de autenticación JWT.
# IMPORTANTE: Debe tener al menos 256 bits (mínimo 32 caracteres seguros).
# Puedes generar una con: openssl rand -base64 48
JWT_SECRET=tu_clave_secreta_jwt_de_al_menos_32_caracteres_seguros_123456789


# ─────────────────────────────────────────────────────────────
# 4. Administradores Iniciales
# ─────────────────────────────────────────────────────────────
# Lista de correos electrónicos que recibirán el rol de 'Administrador' automáticamente
# al iniciar sesión por primera vez en el sistema. Separados por coma y sin espacios.
ADMIN_EMAILS=tu_correo@gmail.com,otro_admin@ejemplo.com


# ─────────────────────────────────────────────────────────────
# 5. Perfil de Spring Boot (Opcional)
# ─────────────────────────────────────────────────────────────
# 'prod' o vacío: versión limpia (no ejecuta DataSeeder).
# 'demo': activa el DataSeeder con proyectos, tareas y tiempos precargados.
# Nota: docker-compose.yml ya define 'prod' y docker-compose.demo.yml define 'demo'.
SPRING_PROFILES_ACTIVE=prod
