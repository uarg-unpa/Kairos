# ── Base de Datos ──
# Contraseña para el usuario root de MySQL
SPRING_DATASOURCE_PASSWORD=tu_contraseña_segura_mysql

# ── Google OAuth 2.0 ──
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret

# ── JWT ──
# Clave secreta para firmar tokens (mínimo 32 caracteres)
JWT_SECRET=tu_clave_secreta_jwt_de_64_caracteres

# ── Administradores ──
# Correos que recibirán rol de Administrador automáticamente (separados por coma)
ADMIN_EMAILS=admin@gmail.com
